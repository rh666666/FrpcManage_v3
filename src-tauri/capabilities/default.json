{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the self-drawn tray menu window",
  "windows": ["main", "tray-menu"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:tray:default"
  ]
}
